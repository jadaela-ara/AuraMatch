# Base de données - Configuration pour développement local
# Pour MongoDB local: utilisez mongodb://localhost:27017/auramatch
# Pour MongoDB Atlas (production): utilisez votre URI Atlas
MONGODB_URI=mongodb://localhost:27017/auramatch
MONGODB_URI_TEST=mongodb://localhost:27017/auramatch_test

# JWT - IMPORTANT: Changez cette clé en production !
JWT_SECRET=auramatch_super_secret_jwt_key_2024_change_in_production_DEMO
JWT_EXPIRES_IN=7d

# OAuth Google 
# Obtenez vos clés sur: https://console.cloud.google.com
# Pour le développement, créez des credentials OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth Facebook
# Obtenez vos clés sur: https://developers.facebook.com
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Gemini AI - REQUIS pour la génération de profils
# Obtenez votre clé sur: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (optionnel pour l'upload d'images)
# Obtenez vos clés sur: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Serveur - Configuration locale
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# URLs de callback OAuth - Pour développement local
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
